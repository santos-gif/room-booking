# Copy to .env.local and fill in local secrets. Never commit .env.local.
SUPABASE_URL=
# Use a server-side Supabase secret/service-role key. Never put it in Angular.
SUPABASE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google-auth/oauth2callback
GOOGLE_CALENDAR_ROOM_1_ID=
GOOGLE_CALENDAR_ROOM_2_ID=
# Generate with Fernet.generate_key(); keep this stable and back it up securely.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Use distinct random values, each at least 32 characters.
SECRET_ACCESS_TOKEN_JWT_KEY=
SECRET_REFRESH_TOKEN_JWT_KEY=
ALGORITHM=HS256

CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
# Use false only for local HTTP development. Production must use HTTPS and true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Use a random value at least 32 characters long; Vercel sends it as Bearer auth.
CRON_SECRET=
