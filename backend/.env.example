# Copy to .env.local and fill in local values. Never commit local env files.
# The app also reads .env.dev, with .env.local taking precedence.
SUPABASE_URL=
# Publishable API key; user Auth tokens are sent separately per request.
SUPABASE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google-auth/oauth2callback
GOOGLE_CALENDAR_ROOM_1_ID=
GOOGLE_CALENDAR_ROOM_2_ID=

# Distinct random values, each at least 32 characters.
CRON_SECRET=
SUPABASE_BACKEND_RPC_SECRET=

CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
# Use false only for local HTTP development. Production must use HTTPS and true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
